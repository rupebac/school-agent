# Copy to .env (ignored by Git), chmod 600, and fill required values.
# Passwords must be non-placeholder strings of at least 12 characters.
POSTGRES_PASSWORD=
# Generate once: openssl rand -base64 32. Preserve this key across all deployments.
SCHOOLAGENT_MASTER_KEY=
# Your actual app origin; for local Compose use http://127.0.0.1:4200.
SCHOOLAGENT_PUBLIC_URL=
# Required only while creating the initial administrator on a new database.
SCHOOLAGENT_INITIAL_USERNAME=
SCHOOLAGENT_INITIAL_PASSWORD=

# Optional integrations remain disabled/unconnected until configured.
SCHOOLAGENT_GOOGLE_CLIENT_ID=
SCHOOLAGENT_GOOGLE_CLIENT_SECRET=
SCHOOLAGENT_AI_API_KEY=
